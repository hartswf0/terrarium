   "code": "function build(w, WG, THREE){\n  /* HLIDARENDI - GUNNAR'S TRAILER. Generated from hlidarendi/src/elements.js,\n     itself transcribed from gunnars-depot operative/ingold.js. Wall pieces are\n     split around real openings: door.entry (wall W, plan 72..108)\n     is an actual hole with a header, the windows are glass. Every visible box\n     is also the collision box: rendered wall = semantic wall = collision wall.\n     30 meshes, all within 3.2 units of the anchor; the host seats the\n     whole structure on its own ground. */\n  var M = {\n    wall: WG.flat(0xf2efe8, { rough: 0.9 }),\n    glass: WG.lit(0xbcd6dd, 0.25),\n    floor: WG.flat(0xc9b48a, { rough: 0.95 }),\n    fixture: WG.flat(0xded2b8, { rough: 0.9 }),\n    frame: WG.flat(0x6b6257, { rough: 0.8, metal: 0.3 }),\n    step: WG.flat(0xb8ab91, { rough: 0.95 })\n  };\n  var E = [\n    [0,0.244,0,2.261,0.234,5.994,'frame'] /*frame*/,\n    [0,0.381,0,2.565,0.038,6.096,'floor'] /*deck*/,\n    [-1.226,1.546,-2.076,0.114,2.292,1.714,'wall'] /*wall.W.s*/,\n    [-1.226,2.562,-0.762,0.114,0.26,0.914,'wall'] /*door.header*/,\n    [-1.226,1.546,-0.051,0.114,2.292,0.508,'wall'] /*wall.W.m*/,\n    [-1.226,0.781,0.711,0.114,0.762,1.016,'wall'] /*win.dinette.sill*/,\n    [-1.226,2.308,0.711,0.114,0.768,1.016,'wall'] /*win.dinette.head*/,\n    [-1.226,1.543,0.711,0.038,0.762,1.016,'glass'] /*win.dinette*/,\n    [-1.226,1.546,2.076,0.114,2.292,1.714,'wall'] /*wall.W.n*/,\n    [1.226,1.546,-2.051,0.114,2.292,1.765,'wall'] /*wall.E.s*/,\n    [1.226,0.959,-0.914,0.114,1.118,0.508,'wall'] /*win.galley.sill*/,\n    [1.226,2.41,-0.914,0.114,0.565,0.508,'wall'] /*win.galley.head*/,\n    [1.226,1.822,-0.914,0.038,0.61,0.508,'glass'] /*win.galley*/,\n    [1.226,1.546,1.137,0.114,2.292,3.594,'wall'] /*wall.E.n*/,\n    [-0.902,1.546,2.991,0.762,2.292,0.114,'wall'] /*wall.N.w*/,\n    [-0.013,0.73,2.991,1.016,0.66,0.114,'wall'] /*win.bed.sill*/,\n    [-0.013,2.257,2.991,1.016,0.87,0.114,'wall'] /*win.bed.head*/,\n    [-0.013,1.441,2.991,1.016,0.762,0.038,'glass'] /*win.bed*/,\n    [0.889,1.546,2.991,0.787,2.292,0.114,'wall'] /*wall.N.e*/,\n    [-0.495,1.546,-2.991,1.575,2.292,0.114,'wall'] /*wall.S.w*/,\n    [0.597,0.857,-2.991,0.61,0.914,0.114,'wall'] /*win.bath.sill*/,\n    [0.597,2.283,-2.991,0.61,0.819,0.114,'wall'] /*win.bath.head*/,\n    [0.597,1.594,-2.991,0.61,0.559,0.038,'glass'] /*win.bath*/,\n    [1.092,1.546,-2.991,0.381,2.292,0.114,'wall'] /*wall.S.e*/,\n    [-0.489,1.419,-1.473,1.359,2.038,0.102,'wall'] /*part.bath*/,\n    [0,0.591,2.286,2.337,0.381,1.321,'fixture'] /*fix.bed*/,\n    [0.883,0.857,-0.813,0.572,0.914,1.219,'fixture'] /*fix.galley*/,\n    [-0.895,0.591,0.686,0.546,0.381,1.473,'fixture'] /*fix.dinette*/,\n    [-1.473,0.133,-0.762,0.381,0.267,0.711,'step'] /*step.hi*/,\n    [-1.854,0.067,-0.762,0.381,0.133,0.711,'step'] /*step.lo*/\n  ];\n  for (var i = 0; i < E.length; i++) {\n    var e = E[i];\n    var b = WG.box(e[3], e[4], e[5], M[e[6]] || M.wall);\n    WG.put(b, e[0], e[1], e[2]);\n    WG.solid(b, e[3], e[4], e[5]);\n  }\n  return w;\n}"
